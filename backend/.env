# ============================================================
#  XERALIT — Environment configuration
#  Copy to `.env` and fill in ONE provider's key.
# ============================================================

# ---- AI provider switch ------------------------------------
# Choose: openrouter | groq | gemini   (all free / dev-friendly)
AI_PROVIDER=groq

# Optional: override the default model for the chosen provider
# openrouter default -> meta-llama/llama-3.1-8b-instruct:free
# groq default       -> llama-3.3-70b-versatile
# gemini default     -> gemini-1.5-flash
# AI_MODEL=llama-3.3-70b-versatile

# ---- API keys (set only the one you use) -------------------
# Groq        -> https://console.groq.com/keys        (free tier)
GROQ_API_KEY=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
# OpenRouter  -> https://openrouter.ai/keys            (free models available)
OPENROUTER_API_KEY=
# Gemini      -> https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=

# ---- App ---------------------------------------------------
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL (optional — mock data used until set) ------
DATABASE_URL=postgresql://xeralit:xeralit@localhost:5432/xeralit
